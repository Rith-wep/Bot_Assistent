DATABASE_URL=postgresql://user:password@localhost:5432/khmer_assistant
# Optional direct PostgreSQL URL for Alembic when DATABASE_URL uses the
# Supabase transaction pooler.
MIGRATION_DATABASE_URL=
# Supabase project URL and browser-safe publishable key. Never place the
# secret/service-role key in a VITE_ variable.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# JWT signing secret. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Fernet key for encrypting bot tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-20b
APP_ENV=development
# Base URL of the React dashboard, used to build links sent in Telegram
# messages (e.g. the weekly summary's "view your Gaps page" link).
FRONTEND_URL=http://localhost:5173
# Comma-separated login emails allowed onto the internal /admin page.
ADMIN_EMAILS=you@example.com
