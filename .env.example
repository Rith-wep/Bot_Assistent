DATABASE_URL=postgresql://user:password@localhost:5432/khmer_assistant
# JWT signing secret. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Fernet key for encrypting bot tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
APP_ENV=development
# Base URL of the React dashboard, used to build links sent in Telegram
# messages (e.g. the weekly summary's "view your Gaps page" link).
FRONTEND_URL=http://localhost:5173
# Comma-separated login emails allowed onto the internal /admin page.
ADMIN_EMAILS=you@example.com
